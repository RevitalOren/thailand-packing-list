# Google Sheets API Configuration
# Copy this file to .env and fill in your actual values

# Google API Key - Get from Google Cloud Console
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google Sheets API
# 4. Create credentials (API Key)
# 5. Restrict the API key to Google Sheets API for security
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Google OAuth Client ID - Get from Google Cloud Console
# Go to Credentials → Create Credentials → OAuth 2.0 Client IDs → Web application
VITE_GOOGLE_CLIENT_ID=your_oauth_client_id_here

# Google Spreadsheet ID - Get from your Google Sheets URL
# From: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Copy the SPREADSHEET_ID part
VITE_GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
