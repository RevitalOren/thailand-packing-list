{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/family-data",
      "dest": "/api/family-data.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/family-data.js": {
      "maxDuration": 10
    },
    "api/health.js": {
      "maxDuration": 5
    }
  }
}